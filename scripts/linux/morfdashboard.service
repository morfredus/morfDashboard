# Service systemd pour morfDashboard.
#
# L'application est INSTALLÉE dans un dossier fixe (par défaut /opt/morfdashboard),
# indépendant de l'endroit où vit le clone git : déplacer/renommer le dépôt (ou
# une synchro Syncthing) ne casse plus le service. install-service.sh remplace
# __RUN_USER__ et __APP_DIR__.
#
# Nom d'unité : « morfdashboard ». morfDashboard surveille ce service par ce
# nom (SERVICE_LABELS dans config.py -> systemctl is-active morfdashboard).

[Unit]
Description=morfDashboard
After=local-fs.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_USER__
WorkingDirectory=__APP_DIR__
Environment=MORFDASHBOARD_CONFIG=/etc/morfsystem/morfdashboard/config.local.py
# État éditable du service (doctrine FS morfSystem) : systemd crée et possède
# /var/lib/morfsystem/morfdashboard, propriété du user du service. C'est là que
# vit backlight.state (forçage manuel du rétroéclairage, voir screenctl.py) ;
# la CLI screenctl.py, lancée par le même utilisateur, y écrit sans privilège.
StateDirectory=morfsystem/morfdashboard
ExecStart=/usr/bin/python3 __APP_DIR__/dashboard.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
